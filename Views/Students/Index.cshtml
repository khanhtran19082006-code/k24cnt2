@model IEnumerable<HvtStudent>
@{
    ViewData["Title"] = "Danh sách sinh viên";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Danh sách sinh viên</h1>
        <p class="text-secondary mb-0">Quản lý thông tin sinh viên trong bảng HvtStudent.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Thêm sinh viên</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã sinh viên</th>
                    <th>Họ và tên</th>
                    <th>Giới tính</th>
                    <th>Ngày sinh</th>
                    <th>Email</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Any())
            {
                foreach (var student in Model)
                {
                    <tr>
                        <td class="fw-semibold">@student.MaSV</td>
                        <td>@student.HoTen</td>
                        <td>@(student.GioiTinh ?? "—")</td>
                        <td>@(student.NgaySinh?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td>@(student.Email ?? "—")</td>
                        <td><span class="badge @(student.DangHoc ? "text-bg-success" : "text-bg-secondary")">@(student.DangHoc ? "Đang học" : "Đã nghỉ")</span></td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@student.MaSV" class="btn btn-sm btn-outline-secondary">Xem</a>
                            <a asp-action="Edit" asp-route-id="@student.MaSV" class="btn btn-sm btn-outline-primary">Sửa</a>
                            <a asp-action="Delete" asp-route-id="@student.MaSV" class="btn btn-sm btn-outline-danger">Xóa</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="7" class="text-center text-secondary py-5">Chưa có sinh viên. Hãy chọn “Thêm sinh viên” để bắt đầu.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
